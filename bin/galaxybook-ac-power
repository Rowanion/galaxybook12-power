#!/bin/bash
# Apply CPU power limits depending on whether the charger is online.
set -u
CONF=/etc/galaxybook-power.conf
AC_PL1=7 AC_PL2=12 BAT_PL1=15 BAT_PL2=25
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

online=0
for p in /sys/class/power_supply/*; do
  [ "$(cat "$p/type" 2>/dev/null)" = Mains ] && [ "$(cat "$p/online" 2>/dev/null)" = 1 ] && online=1
done
if [ $online = 1 ]; then mode=AC pl1=$AC_PL1 pl2=$AC_PL2; else mode=battery pl1=$BAT_PL1 pl2=$BAT_PL2; fi

# Only the MSR interface. The MMIO interface is managed by thermald (adaptive
# DPTF) for thermal protection; the lower of the two always wins, so leaving it
# alone lets thermald throttle further but never lets us override it upward.
for z in /sys/class/powercap/intel-rapl:0; do
  [ -d "$z" ] || continue
  for c in "$z"/constraint_*_name; do
    i="${c%_name}"
    case "$(cat "$c")" in
      long_term)  echo $((pl1 * 1000000)) > "${i}_power_limit_uw" ;;
      short_term) echo $((pl2 * 1000000)) > "${i}_power_limit_uw" ;;
    esac
  done
done
echo "charger $mode: CPU limit ${pl1}W sustained / ${pl2}W burst"
